# Создаём пустой список — он будет работать как наша очередь.
# Очередь — это структура данных, где элементы добавляются в конец,
# а удаляются с начала (как очередь в магазине: первый пришёл — первый обслужен).
queue = []

# Запускаем бесконечный цикл, чтобы программа постоянно читала команды,
# пока пользователь не введёт "exit".
while True:

    # Считываем одну строку от пользователя и убираем лишние пробелы по краям.
    command = input().strip()

    # Проверяем, начинается ли команда со слова "push".
    # Если да — значит, нужно добавить число в очередь.
    if command.startswith("push"):

        # Разделяем строку "push 5" на две части: ["push", "5"].
        # Берём вторую часть (индекс 1) и превращаем её в целое число.
        number = int(command.split()[1])

        # Добавляем число в конец списка (это как встать в конец очереди).
        queue.append(number)

        # Выводим "ok", чтобы показать, что операция прошла успешно.
        print("ok")

    # Если команда — "pop", нужно удалить первый элемент и показать его.
    elif command == "pop":

        # Проверяем, есть ли хоть один элемент в очереди.
        if len(queue) > 0:

            # Удаляем первый элемент из списка (индекс 0) и сохраняем его.
            # В очереди удаляется именно первый элемент (кто первый встал — тот первый вышел).
            value = queue.pop(0)

            # Выводим удалённое значение.
            print(value)

        # Если очередь пуста — вывести ошибку, потому что нечего удалять.
        else:
            print("error")

    # Если команда — "front", нужно показать первый элемент, но НЕ удалять его.
    elif command == "front":

        # Проверяем, есть ли элементы в очереди.
        if len(queue) > 0:

            # Берём первый элемент по индексу 0.
            # Мы его не удаляем, просто смотрим (как посмотреть, кто первый в очереди).
            print(queue[0])

        # Если очередь пуста — вывести ошибку.
        else:
            print("error")

    # Если команда — "size", нужно показать количество элементов в очереди.
    elif command == "size":

        # Функция len() возвращает длину списка, то есть сколько элементов в очереди.
        print(len(queue))

    # Если команда — "clear", нужно полностью очистить очередь.
    elif command == "clear":

        # Присваиваем переменной queue новый пустой список — старый исчезает.
        queue = []

        # Выводим "ok", чтобы подтвердить очистку.
        print("ok")

    # Если команда — "exit", нужно завершить работу программы.
    elif command == "exit":

        # Выводим прощальное сообщение.
        print("bye")

        # Оператор break прерывает бесконечный цикл while True,
        # и программа завершается.
        break
