# Считываем строку с постфиксным выражением от пользователя.
s = input()

# Создаём пустой список — это наш стек для хранения чисел.
stack = []

# Разбиваем строку на отдельные части (токены) по пробелам.
# Например, "8 9 + 1 7 - *" превратится в список ['8', '9', '+', '1', '7', '-', '*'].
# Метод split() автоматически убирает лишние пробелы в конце строки.
tokens = s.split()

# Проходим по каждому элементу списка по очереди.
for token in tokens:

    # Проверяем, является ли текущий элемент числом.
    # Если токен не является оператором (+, -, *), значит это число.
    if token not in '+-*':

        # Превращаем строку в целое число и кладём в стек.
        stack.append(int(token))

    # Если элемент — это знак операции, нужно выполнить вычисление.
    else:

        # Достаём из стека два последних числа.
        # Второе число (правый операнд) — это то, что лежит наверху стека.
        b = stack.pop()

        # Первое число (левый операнд) — это то, что было под верхним.
        a = stack.pop()

        # Проверяем, какой именно знак операции нам встретился.
        if token == '+':

            # Складываем два числа и кладём результат обратно в стек.
            stack.append(a + b)

        elif token == '-':

            # Вычитаем: из первого числа вычитаем второе.
            # Важно: a - b, а не b - a, потому что порядок важен!
            stack.append(a - b)

        elif token == '*':

            # Умножаем два числа и кладём результат обратно в стек.
            stack.append(a * b)

# После обработки всех элементов в стеке должно остаться ровно одно число —
# это и есть результат всего выражения.
# Берём его и выводим.
print(stack[0])
