# Создаём пустой список — он будет работать как наш стек.
# Стек — это структура данных, где элементы добавляются и удаляются только с одного конца (сверху).
stack = []

# Запускаем бесконечный цикл, чтобы программа постоянно читала команды,
# пока пользователь не введёт "exit".
while True:

    # Считываем одну строку от пользователя и убираем лишние пробелы по краям.
    command = input().strip()

    # Проверяем, начинается ли команда со слова "push".
    # Если да — значит, нужно добавить число в стек.
    if command.startswith("push"):

        # Разделяем строку "push 5" на две части: ["push", "5"].
        # Берём вторую часть (индекс 1) и превращаем её в целое число.
        number = int(command.split()[1])

        # Добавляем число в конец списка (это как положить элемент на верхушку стека).
        stack.append(number)

        # Выводим "ok", чтобы показать, что операция прошла успешно.
        print("ok")

    # Если команда — "pop", нужно удалить последний элемент и показать его.
    elif command == "pop":

        # Проверяем, есть ли хоть один элемент в стеке.
        if len(stack) > 0:

            # Удаляем последний элемент из списка и сохраняем его в переменную.
            # Метод pop() без аргумента удаляет именно последний элемент.
            value = stack.pop()

            # Выводим удалённое значение.
            print(value)

        # Если стек пуст — вывести ошибку, потому что нечего удалять.
        else:
            print("error")

    # Если команда — "back", нужно показать последний элемент, но НЕ удалять его.
    elif command == "back":

        # Проверяем, есть ли элементы в стеке.
        if len(stack) > 0:

            # Берём последний элемент по индексу -1 (последний в списке).
            # Мы его не удаляем, просто смотрим.
            print(stack[-1])

        # Если стек пуст — вывести ошибку.
        else:
            print("error")

    # Если команда — "size", нужно показать количество элементов в стеке.
    elif command == "size":

        # Функция len() возвращает длину списка, то есть сколько элементов в стеке.
        print(len(stack))

    # Если команда — "clear", нужно полностью очистить стек.
    elif command == "clear":

        # Присваиваем переменной stack новый пустой список — старый исчезает.
        stack = []

        # Выводим "ok", чтобы подтвердить очистку.
        print("ok")

    # Если команда — "exit", нужно завершить работу программы.
    elif command == "exit":

        # Выводим прощальное сообщение.
        print("bye")

        # Оператор break прерывает бесконечный цикл while True,
        # и программа завершается.
        break
