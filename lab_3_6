# Считываем N и K.
n, k = map(int, input().split())

# Считываем массив чисел.
a = list(map(int, input().split()))

# Пустой список — в нём храним индексы.
dq = []

# Проходим по каждому элементу массива.
for i in range(n):

    # ===== ШАГ 1: Удаляем с конца списка все «ненужные» индексы =====
    # Ненужный индекс — это такой, чьё число в массиве >= текущего числа a[i].
    # Потому что текущее число меньше (или равно) и продержится в окне дольше.

    # Запускаем цикл: повторяем, пока нужно удалять.
    while True:

        # Сначала проверяем: список вообще не пустой?
        if len(dq) == 0:
            # Пустой — удалять нечего, выходим из цикла.
            break

        # Берём последний индекс из списка.
        last_index = dq[-1]

        # Смотрим, какое число стоит в массиве на этом индексе.
        last_value = a[last_index]

        # Сравниваем: это число больше или равно текущему a[i]?
        if last_value >= a[i]:
            # Да, больше или равно — оно нам не нужно, удаляем.
            dq.pop()
        else:
            # Нет, оно меньше текущего — оно полезное, оставляем.
            # Выходим из цикла.
            break

    # ===== ШАГ 2: Добавляем индекс текущего элемента в конец списка =====
    dq.append(i)

    # ===== ШАГ 3: Удаляем индексы, которые вышли за пределы окна =====
    # Окно — это последние K элементов. Его начало: i - k + 1.
    # Если первый индекс в списке меньше этого — он уже не в окне.

    first_index = dq[0]  # Берём первый индекс из списка.

    if first_index < i - k + 1:
        # Этот индекс уже вышел из окна — удаляем его.
        dq.pop(0)

    # ===== ШАГ 4: Если окно полностью заполнено — выводим минимум =====
    # Окно заполняется, когда мы обработали хотя бы K элементов.
    # То есть когда i >= k - 1.

    if i >= k - 1:
        # В начале списка лежит индекс минимального элемента окна.
        min_index = dq[0]
        min_value = a[min_index]
        print(min_value)
