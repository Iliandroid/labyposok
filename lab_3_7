#1. Читаем количество вагонов N и их порядок.
#2. Создаём пустой стек — это наш тупик.
#3. Ожидаем, что следующий вагон на пути 2 должен быть номером 1 (потом 2, 3, ...).
#4. Проходим по каждому вагону поезда:
#   • Если вагон — это тот, который сейчас нужен (номер = ожидаемый),
#     отправляем его сразу на путь 2, увеличиваем ожидаемый номер.
#   • Иначе — заводим вагон в тупик (кладём в стек).
#   • После каждого шага проверяем: может быть, верхушка тупика — это как раз
#     нужный вагон? Если да — вытаскиваем его на путь 2 и повторяем проверку.
#5. В конце, если все вагоны от 1 до N вышли на путь 2 — выводим YES, иначе NO.
# Считываем количество вагонов в поезде.
n = int(input())

# Считываем порядок вагонов — список чисел.
# Например, "3 2 1" превратится в список [3, 2, 1].
wagons = list(map(int, input().split()))

# Создаём пустой список — это наш тупик (работает как стек).
# Вагоны заезжают в тупик и выезжают из него в обратном порядке:
# последний заехавший — первый выехавший.
dead_end = []

# Ожидаемый номер вагона, который должен следующим выехать на путь 2.
# Сначала мы ждём вагон номер 1, потом 2, потом 3 и так далее.
expected = 1

# Проходим по каждому вагону поезда по очереди (от головы к хвосту).
for wagon in wagons:

    # Проверяем: этот вагон — тот, который сейчас нужен на пути 2?
    # То есть его номер равен ожидаемому?
    if wagon == expected:

        # Да! Отправляем его сразу на путь 2 (в тупик не заводим).
        # Увеличиваем ожидаемый номер — теперь ждём следующий вагон.
        expected += 1

        # Но подождите! Может быть, в тупике уже лежит вагон,
        # который тоже сейчас нужен? Проверяем верхушку тупика.
        # Пока тупик не пуст И верхний вагон в тупике — это нужный номер:
        while len(dead_end) > 0 and dead_end[-1] == expected:

            # Вытаскиваем верхний вагон из тупика на путь 2.
            dead_end.pop()

            # Увеличиваем ожидаемый номер — ждём следующий.
            expected += 1

    else:

        # Этот вагон сейчас не нужен — заводим его в тупик.
        # Кладём вагон на верхушку стека.
        dead_end.append(wagon)

# После того как все вагоны из поезда обработаны,
# проверяем: все ли вагоны от 1 до N выехали на путь 2?
# Если expected стал равен N + 1, значит все вагоны вышли по порядку.
if expected == n + 1:

    # Все вагоны отсортированы — выводим YES.
    print("YES")

else:

    # Не все вагоны удалось отсортировать — выводим NO.
    print("NO")
