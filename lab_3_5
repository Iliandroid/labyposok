# Создаём пустой список — он будет работать как наш дек.
# Дек (deque) — это структура данных, где элементы можно добавлять и удалять
# как с начала, так и с конца (двусторонняя очередь).
deque = []

# Запускаем бесконечный цикл, чтобы программа постоянно читала команды,
# пока пользователь не введёт "exit".
while True:

    # Считываем одну строку от пользователя и убираем лишние пробелы по краям.
    command = input().strip()

    # Проверяем, начинается ли команда со слова "push_front".
    # Если да — значит, нужно добавить число в начало дека.
    if command.startswith("push_front"):

        # Разделяем строку "push_front 5" на части: ["push_front", "5"].
        # Берём вторую часть (индекс 1) и превращаем её в целое число.
        number = int(command.split()[1])

        # Добавляем число в начало списка (индекс 0).
        # Метод insert(0, number) вставляет элемент в начало.
        deque.insert(0, number)

        # Выводим "ok", чтобы показать, что операция прошла успешно.
        print("ok")

    # Проверяем, начинается ли команда со слова "push_back".
    # Если да — значит, нужно добавить число в конец дека.
    elif command.startswith("push_back"):

        # Разделяем строку "push_back 5" на части: ["push_back", "5"].
        # Берём вторую часть (индекс 1) и превращаем её в целое число.
        number = int(command.split()[1])

        # Добавляем число в конец списка.
        # Метод append() добавляет элемент в конец.
        deque.append(number)

        # Выводим "ok", чтобы показать, что операция прошла успешно.
        print("ok")

    # Если команда — "pop_front", нужно удалить первый элемент и показать его.
    elif command == "pop_front":

        # Проверяем, есть ли хоть один элемент в деке.
        if len(deque) > 0:

            # Удаляем первый элемент из списка (индекс 0) и сохраняем его.
            # Метод pop(0) удаляет и возвращает элемент по индексу.
            value = deque.pop(0)

            # Выводим удалённое значение.
            print(value)

        # Если дек пуст — вывести ошибку, потому что нечего удалять.
        else:
            print("error")

    # Если команда — "pop_back", нужно удалить последний элемент и показать его.
    elif command == "pop_back":

        # Проверяем, есть ли хоть один элемент в деке.
        if len(deque) > 0:

            # Удаляем последний элемент из списка.
            # Метод pop() без аргумента удаляет и возвращает последний элемент.
            value = deque.pop()

            # Выводим удалённое значение.
            print(value)

        # Если дек пуст — вывести ошибку.
        else:
            print("error")

    # Если команда — "front", нужно показать первый элемент, но НЕ удалять его.
    elif command == "front":

        # Проверяем, есть ли элементы в деке.
        if len(deque) > 0:

            # Берём первый элемент по индексу 0.
            # Мы его не удаляем, просто смотрим.
            print(deque[0])

        # Если дек пуст — вывести ошибку.
        else:
            print("error")

    # Если команда — "back", нужно показать последний элемент, но НЕ удалять его.
    elif command == "back":

        # Проверяем, есть ли элементы в деке.
        if len(deque) > 0:

            # Берём последний элемент по индексу -1.
            # Мы его не удаляем, просто смотрим.
            print(deque[-1])

        # Если дек пуст — вывести ошибку.
        else:
            print("error")

    # Если команда — "size", нужно показать количество элементов в деке.
    elif command == "size":

        # Функция len() возвращает длину списка, то есть сколько элементов в деке.
        print(len(deque))

    # Если команда — "clear", нужно полностью очистить дек.
    elif command == "clear":

        # Присваиваем переменной deque новый пустой список — старый исчезает.
        deque = []

        # Выводим "ok", чтобы подтвердить очистку.
        print("ok")

    # Если команда — "exit", нужно завершить работу программы.
    elif command == "exit":

        # Выводим прощальное сообщение.
        print("bye")

        # Оператор break прерывает бесконечный цикл while True,
        # и программа завершается.
        break
