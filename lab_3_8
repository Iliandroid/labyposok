import sys
from collections import deque

# Настраиваем быстрый ввод-вывод.
# sys.stdin.read() читает весь ввод сразу — это намного быстрее, чем input() в цикле.
input_data = sys.stdin.read().split()

# Два deque — левая и правая половины очереди.
left = deque()
right = deque()

# Результат будем собирать в список, чтобы вывести всё разом в конце.
output = []

# Индекс для чтения входных данных.
idx = 0

# Считываем количество запросов.
n = int(input_data[idx])
idx += 1

# Обрабатываем каждый запрос.
for _ in range(n):

    # Читаем тип запроса.
    query_type = input_data[idx]
    idx += 1

    if query_type == "+":

        # Обычный гоблин — читаем его номер и встаёт в конец очереди.
        goblin_number = int(input_data[idx])
        idx += 1

        # Ставим гоблина в конец правой половины (это конец всей очереди).
        right.append(goblin_number)

        # Балансируем: если left слишком короткий, перекладываем из right.
        while len(left) < len(right):
            left.append(right.popleft())

    elif query_type == "*":

        # Привилегированный гоблин — читаем его номер и встаёт в середину.
        goblin_number = int(input_data[idx])
        idx += 1

        # Ставим гоблина в конец левой половины (это середина очереди).
        left.append(goblin_number)

        # Балансируем: если left слишком длинный, перекладываем в right.
        while len(left) > len(right) + 1:
            right.appendleft(left.pop())

    elif query_type == "-":

        # Первый гоблин уходит — берём из начала левой половины.
        goblin_number = left.popleft()

        # Добавляем номер в список результатов.
        output.append(str(goblin_number))

        # Балансируем: если left слишком короткий, перекладываем из right.
        while len(left) < len(right):
            left.append(right.popleft())

# Выводим все результаты разом — это намного быстрее, чем print() в цикле.
# join() склеивает все строки через символ новой строки.
sys.stdout.write("\n".join(output) + "\n" if output else "")
