# Считываем строку со скобками от пользователя.
s = input()

# Создаём пустой список — это наш стек.
# В него мы будем складывать открывающие скобки, которые ещё не закрылись.
stack = []

# Создаём словарь-соответствие: для каждой закрывающей скобки указываем,
# какая открывающая скобка ей соответствует.
# Это нужно, чтобы проверять, правильная ли пара скобок.
pairs = {')': '(', ']': '[', '}': '{'}

# Флаг-переменная: пока считаем, что последовательность правильная.
# Если найдём ошибку — изменим на False.
correct = True

# Проходим по каждому символу в строке по очереди.
for char in s:

    # Проверяем, является ли символ открывающей скобкой.
    # Если да — кладём его в стек (он ждёт свою закрывающую пару).
    if char in '([{':
        stack.append(char)

    # Проверяем, является ли символ закрывающей скобкой.
    elif char in ')]}':

        # Сначала проверяем: не пуст ли стек?
        # Если стек пуст — значит, закрывающей скобке нечего закрывать.
        # Это ошибка — последовательность неправильная.
        if len(stack) == 0:
            correct = False
            # Выходим из цикла, дальше проверять нет смысла.
            break

        # Берём последний элемент из стека (верхнюю скобку) и удаляем его.
        # Это та открывающая скобка, которую мы пытаемся закрыть.
        top = stack.pop()

        # Проверяем: совпадает ли эта открывающая скобка с той,
        # которая должна соответствовать текущей закрывающей?
        # Например, если char = ')', то pairs[')'] = '(', и top должен быть '('.
        if top != pairs[char]:
            # Если не совпадает — скобки разных типов, это ошибка.
            correct = False
            # Выходим из цикла.
            break

# После прохода по всей строке делаем финальную проверку:
# стек должен быть пустым — все открывающие скобки должны быть закрыты.
# Если в стеке что-то осталось — значит, есть незакрытые скобки.
if len(stack) != 0:
    correct = False

# Выводим результат: если флаг correct остался True — выводим "yes",
# иначе выводим "no".
if correct:
    print("yes")
else:
    print("no")
